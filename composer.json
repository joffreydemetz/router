{
    "name": "jdz/router",
    "type": "library",
    "description": "JDZ Router is a PHP routing library built on top of the Symfony Routing component.",
    "keywords": [
        "JDZ",
        "router",
        "core"
    ],
    "homepage": "https://jdz.joffreydemetz.com/router",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/string": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\Router\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\Router\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox"
    }
}
